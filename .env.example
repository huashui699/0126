# Supabase Dashboard -> Connect -> App Frameworks -> Next.js
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
# Both secrets must be at least 32 random characters and must be different.
CRON_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_SECRET=replace-with-a-different-32-character-secret

# Provider/model choice is intentionally not hardcoded. Configure only after
# budget, provider and current model ID are approved.
AI_PROCESSING_PROVIDER=
AI_PROCESSING_MODEL_ID=
# Local development uses this server-only key. Vercel deployments may use OIDC.
AI_GATEWAY_API_KEY=

# Keep false outside an explicitly approved Day 25 simulation replay.
INGESTION_ENABLE_MOCK=false
